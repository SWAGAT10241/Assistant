# ===================================================
# Virtual Assistant Backend Configuration Template
# ===================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB connection string)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/virtualAssistant?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=your_super_secret_jwt_key_min_32_characters

# Google Gemini API
# Direct endpoint with your Gemini API Key
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent?key=your_gemini_api_key

# Cloudinary Storage Configuration
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://assistant-ox8s.onrender.com